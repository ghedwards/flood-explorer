{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flood Explorer",
  "version": "0.1.0",
  "identifier": "au.gov.flood-explorer",
  "build": {
    "beforeDevCommand": "node scripts/build-desktop.js",
    "beforeBuildCommand": "node scripts/build-desktop.js",
    "frontendDist": "../site"
  },
  "app": {
    "windows": [
      {
        "title": "Flood Explorer",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": "all"
  }
}
