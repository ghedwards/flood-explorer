{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flood Explorer",
  "version": "0.1.0",
  "identifier": "au.gov.flood-explorer",
  "build": {
    "beforeDevCommand": "FLOOD_BROKER_URL=http://127.0.0.1:8787 VITE_DATA_SOURCE=runtime npm run build",
    "beforeBuildCommand": "FLOOD_BROKER_URL=http://127.0.0.1:8787 VITE_DATA_SOURCE=runtime npm run build",
    "frontendDist": "../site"
  },
  "app": {
    "windows": [
      {
        "title": "Flood Explorer",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../site/*", "../viewer/data/national/*"]
  }
}