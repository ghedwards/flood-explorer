# Copy to .env.local (ignored). Load explicitly before running local commands:
#   set -a; . ./.env.local; set +a
# npm, Cargo and the pipeline do not automatically load this root file.
# Leave optional credentials empty until configured. See docs/services-and-credentials.md.

# Public frontend build configuration; these values are embedded in the viewer.
FLOOD_BROKER_URL=http://127.0.0.1:8787
DATA_SOURCE=runtime

# Local standalone broker. Desktop has its own defaults; see settings.example.ini.
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost,tauri://localhost,http://127.0.0.1:1430,http://localhost:1430,http://tauri.localhost,https://tauri.localhost
CACHE_MINUTES=10
READINGS_REFRESH_MINUTES=15
FLOOD_STORAGE=local
# Optional overrides; blank means use the program's default.
FLOOD_DATA_DIR=
FLOOD_SETTINGS=

# Private feed keys: consumed by broker/pipeline, never by frontend code.
# QLD: blank uses the built-in shared public key. NSW: blank skips the feed.
QLD_TRAFFIC_API_KEY=
NSW_TRAFFIC_API_KEY=
# Google Flood Forecasting: used by `flood floodhub`, not the broker.
FLOOD_FORECASTING_API_KEY=

# Optional local desktop release signing. GitHub builds use Actions config instead.
# The updater key is generated locally, not obtained by registering a service.
# FLOOD_UPDATER_PUBLIC_KEY=
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# Apple variables must be UNSET for unsigned/ad-hoc builds: do not export empty
# values. Uncomment and fill the complete set only when configuring signing.
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=
# APPLE_SIGNING_IDENTITY=
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=
