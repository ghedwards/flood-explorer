{
  "name": "flood-explorer",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:smoke": "node tests/smoke_live.js",
    "test:sources": "node tests/probe_sources.js",
    "serve": "vite",
    "lint": "eslint viewer tests scripts *.mjs",
    "check:outdated": "npm outdated",
    "check:security": "npm audit --audit-level=low",
    "build": "node scripts/build-wasm.js && vite build",
    "preview": "vite preview",
    "build:wasm": "node scripts/build-wasm.js",
    "preserve": "node scripts/build-wasm.js",
    "test:build": "node --test --test-timeout=120000 --test-force-exit tests/build/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "pixelmatch": "^8.0.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "esri-leaflet": "3.0.19",
    "geotiff": "3.0.5",
    "leaflet": "1.9.4",
    "three": "0.186.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
